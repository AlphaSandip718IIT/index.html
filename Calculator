<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <!-- Added for app-like / full-screen behavior -->
    <meta name="theme-color" content="#1c242f">
    <meta name="background-color" content="#1c242f">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="fullscreen" content="yes">

    <title>Advanced Scientific Calculator with Graph</title>

    <style>
        :root {
            --safe-top: env(safe-area-inset-top, 0px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);
            --safe-left: env(safe-area-inset-left, 0px);
            --safe-right: env(safe-area-inset-right, 0px);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #1c242f;                    /* solid color helps reduce flash */
            min-height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: calc(20px + var(--safe-top)) 20px calc(20px + var(--safe-bottom));
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent; /* better mobile feel */
        }

        .calculator {
            width: 100%;
            max-width: 420px;
            background: linear-gradient(145deg, #404d5c, #2e3946);
            border-radius: 30px;
            box-shadow: 20px 20px 40px #1b222b, -20px -20px 40px #4f5d6e;
            padding: 20px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }

        /* rest of your styles remain unchanged */
        .display {
            width: 100%;
            height: 80px;
            background: linear-gradient(145deg, #2c3b47, #212a33);
            border: none;
            border-radius: 15px;
            font-size: 28px;
            text-align: right;
            color: #fff;
            padding-right: 20px;
            margin-bottom: 20px;
            box-shadow: inset 8px 8px 16px #1c242c, inset -8px -8px 16px #3a4a57;
            white-space: nowrap;
            overflow-x: auto;
            box-sizing: border-box;
        }

        .toggle-btn {
            width: 100%;
            height: 60px;
            font-size: 22px;
            font-weight: bold;
            color: #fff;
            background: linear-gradient(145deg, #3a4755, #252e38);
            border: none;
            border-radius: 15px;
            box-shadow: 10px 10px 20px #1a2027, -10px -10px 20px #3b4956;
            cursor: pointer;
            margin-bottom: 15px;
        }

        .buttons, .advanced-buttons {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        button {
            height: 65px;
            font-size: 20px;
            font-weight: bold;
            color: #fff;
            background: linear-gradient(145deg, #2e3b47, #1d262f);
            border: none;
            border-radius: 15px;
            box-shadow: 10px 10px 20px #1a2027, -10px -10px 20px #3b4956;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        button:hover {
            background: linear-gradient(145deg, #1d262f, #2e3b47);
            box-shadow: 15px 15px 30px #171d23, -15px -15px 30px #404e5b;
            transform: scale(1.05);
        }

        button:active {
            box-shadow: inset 8px 8px 16px #1a2027, inset -8px -8px 16px #3b4956;
            transform: scale(0.98);
        }

        #modeBtn {
            background: linear-gradient(145deg, #4a5a6a, #303a47);
            font-weight: bolder;
            grid-column: 1 / 5;
        }

        #graphContainer {
            margin-top: 20px;
            padding: 20px;
            background: rgba(28, 36, 47, 0.85);
            border-radius: 18px;
            display: none;
            box-sizing: border-box;
            width: 100%;
            border: 1px solid #3a4755;
            overflow-y: auto;
            max-height: 60vh;
            -webkit-overflow-scrolling: touch;
        }

        #graphTitle {
            color: #e0f0ff;
            text-align: center;
            font-size: 18px;
            margin-bottom: 15px;
            font-weight: 600;
        }

        #graphCanvas {
            width: 100%;
            height: 380px;
            background: #1c242f;
            border-radius: 14px;
            box-shadow: inset 6px 6px 12px #141b24, 6px 6px 12px #242e3a;
            display: block;
            margin: 0 auto;
            border: 2px solid #4a5a6a;
            box-sizing: border-box;
        }

        @media (max-width: 420px) {
            #graphCanvas { height: 320px; }
            #graphContainer { padding: 15px; max-height: 50vh; }
        }
    </style>
</head>
<body>

    <!-- Added: attempt to go fullscreen (works best in standalone/PWA mode) -->
    <script>
        function enterFullscreen() {
            const elem = document.documentElement;
            if (elem.requestFullscreen) {
                elem.requestFullscreen().catch(() => {});
            } else if (elem.webkitRequestFullscreen) {
                elem.webkitRequestFullscreen();
            } else if (elem.msRequestFullscreen) {
                elem.msRequestFullscreen();
            }
        }

        // Try on load, touch/click (more reliable in WebView & browsers)
        window.addEventListener('load', enterFullscreen);
        document.addEventListener('touchstart', enterFullscreen, { once: true });
        document.addEventListener('click', enterFullscreen, { once: true });
    </script>

    <div class="calculator">
        <input type="text" class="display" id="display" disabled />
        
        <button class="toggle-btn" id="toggleAdv" onclick="toggleAdvanced()">▼ Advanced</button>
        
        <div id="advancedButtons" class="advanced-buttons" style="display: none;">
            <button onclick="appendValue('sin(')">sin</button>
            <button onclick="appendValue('cos(')">cos</button>
            <button onclick="appendValue('tan(')">tan</button>
            <button onclick="appendValue('ln(')">ln</button>
            <button onclick="appendValue('log(')">log</button>
            <button onclick="appendValue('x')">x</button>
            <button onclick="appendValue('π')">π</button>
            <button onclick="appendValue('e')">e</button>
            <button onclick="appendValue('%')">%</button>
            <button onclick="appendValue('√(')">√</button>
            <button onclick="appendValue('∛(')">∛</button>
            <button onclick="appendValue('^')">^</button>
            <button onclick="appendValue('!')">x!</button>
        </div>

        <div class="buttons">
            <button onclick="appendValue('(')">(</button>
            <button onclick="appendValue(')')">)</button>
            <button onclick="clearDisplay()">C</button>
            <button onclick="deleteLast()">DEL</button>
            <button onclick="appendValue('7')">7</button>
            <button onclick="appendValue('8')">8</button>
            <button onclick="appendValue('9')">9</button>
            <button onclick="appendValue('/')">÷</button>
            <button onclick="appendValue('4')">4</button>
            <button onclick="appendValue('5')">5</button>
            <button onclick="appendValue('6')">6</button>
            <button onclick="appendValue('*')">×</button>
            <button onclick="appendValue('1')">1</button>
            <button onclick="appendValue('2')">2</button>
            <button onclick="appendValue('3')">3</button>
            <button onclick="appendValue('-')">-</button>
            <button onclick="appendValue('.')">.</button>
            <button onclick="appendValue('0')">0</button>
            <button onclick="calculate()">=</button>
            <button onclick="appendValue('+')">+</button>
            <button id="modeBtn" onclick="toggleMode()">DEG</button>
        </div>
        
        <div id="graphContainer">
            <div id="graphTitle"></div>
            <canvas id="graphCanvas"></canvas>
        </div>
    </div>

    <script>
        // ────────────────────────────────────────────────
        // Your original JavaScript remains unchanged below
        // ────────────────────────────────────────────────

        const display = document.getElementById('display');
        let mode = 'DEG';
        let lastExpr = '';

        document.getElementById('modeBtn').innerText = mode;

        function appendValue(value) {
            display.value += value;
        }

        function clearDisplay() {
            display.value = '';
            lastExpr = '';
            document.getElementById('graphContainer').style.display = 'none';
        }

        function deleteLast() {
            display.value = display.value.slice(0, -1);
        }

        function toggleAdvanced() {
            const adv = document.getElementById('advancedButtons');
            const btn = document.getElementById('toggleAdv');
            if (adv.style.display === 'none' || adv.style.display === '') {
                adv.style.display = 'grid';
                btn.innerHTML = '▲ Advanced';
            } else {
                adv.style.display = 'none';
                btn.innerHTML = '▼ Advanced';
            }
            document.body.offsetHeight;
        }

        function toggleMode() {
            mode = mode === 'DEG' ? 'RAD' : 'DEG';
            document.getElementById('modeBtn').innerText = mode;
            if (lastExpr) {
                display.value = lastExpr;
                calculate();
            }
        }

        function roundResult(num) {
            if (typeof num !== 'number' || !Number.isFinite(num)) return num;
            return Math.round(num * 1e12) / 1e12;
        }

        function factorial(n) {
            n = Math.floor(n);
            if (n < 0) return NaN;
            if (n === 0 || n === 1) return 1;
            let result = 1;
            for (let i = 2; i <= n; i++) result *= i;
            return result;
        }

        function compute(expr) {
            let prepared = expr
                .replace(/√\(/g, 'Math.sqrt(')
                .replace(/∛\(/g, 'Math.cbrt(')
                .replace(/\^/g, '**')
                .replace(/π/g, 'Math.PI')
                .replace(/e/g, 'Math.E')
                .replace(/log\(/g, 'Math.log10(')
                .replace(/ln\(/g, 'Math.log(')
                .replace(/%/g, '/100');

            const toRadIfDeg = x => mode === 'DEG' ? x * Math.PI / 180 : x;
            const sin = x => Math.sin(toRadIfDeg(x));
            const cos = x => Math.cos(toRadIfDeg(x));
            const tan = x => Math.tan(toRadIfDeg(x));

            const factRegex = /(\d+(\.\d+)?|\([^()]*\))!/g;
            prepared = prepared.replace(factRegex, (match, p1) => {
                let token = p1.startsWith('(') && p1.endsWith(')') ? p1.slice(1,-1) : p1;
                let val = new Function('sin','cos','tan', 'return '+token)(sin,cos,tan);
                return factorial(Math.floor(roundResult(val)));
            });

            return new Function('sin','cos','tan', 'return '+prepared)(sin,cos,tan);
        }

        function plotFunction(expr) {
            const container = document.getElementById('graphContainer');
            const title = document.getElementById('graphTitle');
            const canvas = document.getElementById('graphCanvas');
            const ctx = canvas.getContext('2d');

            title.innerText = `Graph of y = \( {expr} ( \){mode} mode)`;
            container.style.display = 'block';

            container.offsetHeight;

            canvas.width = canvas.clientWidth;
            canvas.height = canvas.clientHeight;
            const w = canvas.width;
            const h = canvas.height;

            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = '#1c242f';
            ctx.fillRect(0, 0, w, h);

            const isTrig = /\b(sin|cos|tan)\(/.test(expr);

            let rangeX = isTrig ? (mode === 'DEG' ? 360 : 2 * Math.PI) : 10;
            let rangeY = isTrig ? 1.5 : 10;

            const scaleX = w / (2 * rangeX);
            const scaleY = h / (2 * rangeY);

            // ── rest of plotFunction remains unchanged ──
            // (grid, axes, labels, plotting logic...)
            ctx.strokeStyle = '#2f3a47';
            ctx.lineWidth = 1;

            const gridStepX = isTrig ? (mode === 'DEG' ? 90 : Math.PI) : 2;
            for (let i = -rangeX; i <= rangeX; i += gridStepX) {
                const px = w/2 + i * scaleX;
                ctx.beginPath();
                ctx.moveTo(px, 0);
                ctx.lineTo(px, h);
                ctx.stroke();
            }
            for (let i = -rangeY; i <= rangeY; i += 0.5) {
                const py = h/2 - i * scaleY;
                ctx.beginPath();
                ctx.moveTo(0, py);
                ctx.lineTo(w, py);
                ctx.stroke();
            }

            ctx.strokeStyle = '#6f7d8e';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(0, h/2);
            ctx.lineTo(w, h/2);
            ctx.moveTo(w/2, 0);
            ctx.lineTo(w/2, h);
            ctx.stroke();

            ctx.fillStyle = '#dddddd';
            ctx.font = '11px sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'top';

            if (isTrig) {
                let xValues, xLabels;
                if (mode === 'DEG') {
                    xValues = [-360, -270, -180, -90, 0, 90, 180, 270, 360];
                    xLabels = xValues.map(v => v + '°');
                } else {
                    xValues = [-2*Math.PI, -Math.PI, 0, Math.PI, 2*Math.PI];
                    xLabels = ['-2π', '-π', '0', 'π', '2π'];
                }
                xValues.forEach((val, i) => {
                    const px = w/2 + val * scaleX;
                    if (px > 30 && px < w - 30) {
                        ctx.save();
                        ctx.translate(px, h/2 + 10);
                        if (Math.abs(val) >= 180 || (mode === 'RAD' && Math.abs(val) >= Math.PI)) {
                            ctx.rotate(-Math.PI / 4);
                            ctx.textAlign = 'right';
                        }
                        ctx.fillText(xLabels[i], 0, 0);
                        ctx.restore();
                    }
                });
            } else {
                ctx.fillText('0', w/2 + 12, h/2 + 10);
            }

            if (isTrig) {
                ctx.textAlign = 'right';
                ctx.textBaseline = 'middle';
                ctx.fillStyle = '#dddddd';
                const y1    = h/2 - scaleY * 1;
                const yNeg1 = h/2 + scaleY * 1;
                ctx.fillText('1',  w/2 - 10, y1);
                ctx.fillText('-1', w/2 - 10, yNeg1);
                ctx.fillText('0',  w/2 - 10, h/2 + 4);
            }

            let prepared = expr
                .replace(/√\(/g, 'Math.sqrt(')
                .replace(/∛\(/g, 'Math.cbrt(')
                .replace(/\^/g, '**')
                .replace(/π/g, 'Math.PI')
                .replace(/e/g, 'Math.E')
                .replace(/log\(/g, 'Math.log10(')
                .replace(/ln\(/g, 'Math.log(')
                .replace(/%/g, '/100');

            const toRad = val => mode === 'DEG' ? val * Math.PI / 180 : val;
            const gSin = val => Math.sin(toRad(val));
            const gCos = val => Math.cos(toRad(val));
            const gTan = val => Math.tan(toRad(val));

            let f;
            try {
                f = new Function('x', 'sin', 'cos', 'tan', `return ${prepared}`);
            } catch (e) {
                display.value = "Syntax Error";
                container.style.display = 'none';
                return;
            }

            ctx.strokeStyle = '#00ff88';
            ctx.lineWidth = 3;
            let first = true;
            const steps = 1200;

            for (let i = 0; i <= steps; i++) {
                const t = i / steps;
                const x = -rangeX + (2 * rangeX) * t;
                let y;
                try {
                    y = f(x, gSin, gCos, gTan);
                    if (!Number.isFinite(y)) throw 'inf';
                } catch {
                    if (!first) ctx.stroke();
                    first = true;
                    continue;
                }

                if (Math.abs(y) > rangeY * 2.5) {
                    if (!first) ctx.stroke();
                    first = true;
                    continue;
                }

                const px = w/2 + x * scaleX;
                const py = h/2 - y * scaleY;

                if (first) {
                    ctx.beginPath();
                    ctx.moveTo(px, py);
                    first = false;
                } else {
                    ctx.lineTo(px, py);
                }
            }
            if (!first) ctx.stroke();
        }

        function calculate() {
            try {
                let expr = display.value.trim();
                if (!expr) return;

                lastExpr = expr;

                if (expr.includes('x')) {
                    if (expr.includes('!')) throw "Factorial not supported in graphs";
                    plotFunction(expr);
                } else {
                    let result = compute(expr);
                    display.value = roundResult(result);
                    document.getElementById('graphContainer').style.display = 'none';
                }
            } catch (e) {
                display.value = "Error";
                document.getElementById('graphContainer').style.display = 'none';
                lastExpr = '';
            }
        }
    </script>
</body>
</html>
